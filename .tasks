# vim: set fenc=utf-8 ft=dosini:
# see: https://github.com/skywind3000/asynctasks.vim/wiki/Task-Config

[cmake-reconfigure:release]
command=rm -rf build; cmake -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo && cmake --build build
output=quickfix
cwd=$(VIM_ROOT)
save=2

[cmake-reconfigure:debug]
command=rm -rf build; cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build
output=quickfix
cwd=$(VIM_ROOT)
save=2

[cmake-build-run-main]
command/linux=cmake --build build && ./build/main
command/win32=cmake --build build && .\build\main
output=quickfix
cwd=$(VIM_ROOT)
save=2

[cmake-build-run-test]
command/linux=cmake --build build && ./build/test
command/win32=cmake --build build && .\build\test
output=terminal
cwd=$(VIM_ROOT)
save=2

[cmake-build-disassamble]
command/linux=cmake --build build && objdump -dS build/main > main.txt; objdump -dS build/test > test.txt
command/win32=cmake --build build && objdump -dS build\main.exe > main.txt && objdump -dS build\test.exe > test.txt
output=terminal
cwd=$(VIM_ROOT)
save=2

